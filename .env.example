DATABASE_URL=postgresql+psycopg://rumo:rumo@localhost:5432/rumo
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# modelo do preenchimento de vagas em segundo plano (tem cota diária própria no Groq)
GROQ_FILL_MODEL=openai/gpt-oss-20b
GROQ_MAX_PER_MINUTE=25
DEFAULT_USER_ID=1
# Hugging Face model cache (worker). Docker mounts the hf_cache volume at /root/.cache/huggingface.
# For local runs, set HF_HOME to a persistent directory to avoid re-downloading BAAI/bge-m3.
# HF_HOME=/path/to/hf-cache
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Job collection (marco 3)
# Hours between collections of each company board.
COLLECT_INTERVAL_HOURS=6
# Pause (seconds) between requests to the same source.
COLLECT_DELAY_SECONDS=1.0
# Max companies collected per worker tick (keeps other worker jobs responsive).
COLLECT_MAX_COMPANIES_PER_RUN=3
# A collect tick stops claiming companies after this many seconds.
COLLECT_MAX_SECONDS=60
# Jobs embedded per worker tick (small: keeps interview turns responsive).
JOB_EMBED_BATCH_SIZE=2
FETCH_TIMEOUT_SECONDS=20
# Max response body size accepted from a job board.
FETCH_MAX_BYTES=20000000
# Jobs sent to the LLM per fill batch (once a minute; shares the Groq quota with the interview).
LLM_FILL_BATCH=3

# Job matching (marco 4a)
# Matches scored by the LLM per worker tick (shares the Groq quota).
MATCH_BATCH=3
# Top-N candidates by vector score sent to the LLM.
MATCH_TOP_N=30
# Max matches scored by the LLM in any rolling 24 h, all users (Groq daily budget).
MATCH_DAILY_LIMIT=20
# Seconds one scoring call may take (rate-limit waits included) before pausing scoring.
MATCH_CALL_TIMEOUT=25

# Automatic company discovery
# Candidate boards validated per worker tick.
DISCOVERY_BATCH=5
# Max automatically added companies per user.
DISCOVERY_MAX_AUTO_COMPANIES=100

# Job sources (marco 3b)
# Aggregator keys: never commit values; leave empty to keep the source off.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_KEY=
CAREERJET_KEY=

# Candidatura (marco 5)
# Gerações de currículo em 24 h, todos os usuários (teto diário do Groq).
APPLICATION_DAILY_LIMIT=5
APPLICATION_MAX_ATTEMPTS=3
# Segundos por chamada ao LLM da candidatura.
APPLICATION_CALL_TIMEOUT=25
# Segundos para buscar as perguntas da vaga no Greenhouse.
GREENHOUSE_QUESTIONS_TIMEOUT=10
